# ==========================================
# Araxie — Environment Variables (.env.example)
# ==========================================

# Base URL of the deployment
NEXT_PUBLIC_APP_URL=https://araxie.vercel.app

# ------------------------------------------
# PayPal Developer Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ------------------------------------------
# Google Gemini 2.5 Flash API Key
# Get this from https://aistudio.google.com/app/apikey
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# Cryptographic License Key Signing Secret
# Any 32+ character random string for HMAC-SHA256
# ------------------------------------------
LICENSE_HMAC_SECRET=araxie-super-secret-hmac-key-2026-secure

# ------------------------------------------
# Supabase Configuration (Optional - for persistent cloud storage)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
